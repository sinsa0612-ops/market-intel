# market-intel — copy to a project-root .env and fill in real values.
# Never commit the real .env (already gitignored).

# FRED (St. Louis Fed) API key — https://fred.stlouisfed.org/docs/api/api_key.html
MI_FRED_API_KEY=

# ECOS (Bank of Korea) API key — https://ecos.bok.or.kr/api/#/
MI_ECOS_API_KEY=

# DART (Korea Financial Supervisory Service) API key — https://opendart.fss.or.kr/
MI_DART_API_KEY=

# SEC EDGAR requires an identifying User-Agent (name + contact email), e.g.:
# "market-intel-collector you@example.com"
MI_SEC_USER_AGENT=

# KRX 오픈API 인증키 — https://openapi.krx.co.kr/ (무료 신청)
# 한국 투자자별 수급(외국인·기관·개인 순매수). KRX가 익명 접근을 막은 뒤
# 유일하게 살아 있는 공식 경로다(2026-08-01 실측: data.krx.co.kr JSON은
# 400/403, 네이버 금융은 구조 변경으로 추출 0건). 비어 있으면 수집기가
# 네트워크를 두드리지도 않고 "키없음"으로 기록한다.
MI_KRX_API_KEY=

# Optional overrides
# MI_DB_PATH=var/market_intel.db
# MI_RAW_DIR=var/raw
# MI_LOG_DIR=var/logs

# Obsidian vault directory for `market-intel obsidian sync` (spec B9/B12).
# Default when unset: ~/Pensieve/market-intel
# MI_OBSIDIAN_DIR=/path/to/your/vault/market-intel

# Python interpreter scripts/publish.sh uses for the secret gate.
# Default when unset: python3
# MI_PYTHON=python3

# --- AI 해석 (2단계-B) -------------------------------------------------------
# 전부 비밀이 아니라 설정값이다. 여기에 API 키를 넣을 자리는 없다 — Claude는
# CLI(`claude -p`)가 이미 로그인해 둔 세션을 쓰고, ollama는 이 맥의 로컬
# (루프백)에서 인증 없이 돈다. 둘 다 죽어도 리포트와 사이트는 그대로 발행되고
# 해석 칸만 "AI 해석 미생성"으로 남는다(명세 SA-9).
#
# 기본 백엔드는 Claude Code CLI(haiku), 실패하면 ollama로 자동 폴백한다
# (CEO 결정 2026-08-03, 근거는 interp/llm.py 첫 주석의 실측표).

# 해석에 쓰는 Claude 모델. Default when unset: haiku
# MI_CLAUDE_MODEL=haiku

# claude 실행 파일. 비워 두면 PATH -> ~/.local/bin/claude 순으로 찾는다
# (launchd는 최소 PATH로 시작해 PATH에서는 못 찾는다).
# MI_CLAUDE_BIN=/Users/<you>/.local/bin/claude

# claude 한 번의 생성을 기다리는 초. 실측 68~95초. Default when unset: 300
# MI_CLAUDE_TIMEOUT_S=300

# `ollama`로 두면 Claude를 아예 안 부르고 무과금 경로에만 머문다(폴백 검증용).
# MI_LLM_BACKEND=ollama

# ollama 주소. Default when unset: http://127.0.0.1:11434
# MI_LLM_HOST=http://127.0.0.1:11434

# 폴백에 쓰는 ollama 모델. Default when unset: qwen3.5:9b
# MI_LLM_MODEL=qwen3.5:9b

# ollama 한 번의 생성 요청을 기다리는 초. Default when unset: 120
# MI_LLM_TIMEOUT_S=120

# 자동 실행 1회가 해석할 리포트 수 상한(캐치업이 밀렸을 때 폭주 방지).
# 오늘 리포트는 이 상한과 무관하게 항상 해석한다. Default when unset: 3
# MI_INTERP_MAX_PER_RUN=3

# 가설 원장 파일 위치는 환경변수가 아니라 `--file`로 준다:
#   market-intel thesis load --file theses/theses.json
# (기본값은 <repo>/theses/theses.json. 명세 SA-13이 적어 둔 MI_THESIS_FILE은
#  실제로 읽는 코드가 없어 여기 적지 않는다 — 없는 설정을 문서화하면 그게 버그다.)
