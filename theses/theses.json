            ]
          }
        }
      ]
    },
    "policy_geo": {
      "label": "정책·지정학",
      "theses": [
        {
          "id": "policy_geo_1",
          "slot": 1,
          "statement": "원화 약세는 구조적이며 쉽게 되돌려지지 않는다. 한미 금리차가 좁혀지지 않는 한 자금은 달러로 남고, 원/달러 1,400원대는 예외가 아니라 새 기준선이다. 원화가 약하면 한국 수출기업의 원화 환산 실적은 좋아 보이지만 외국인 입장에서는 환차손이 붙는다 — 그래서 이 가설은 AI·반도체 가설의 한국 쪽 수급과 반대로 작동할 수 있다.",
          "leading_indicators": ["731Y001.0000001 value", "722Y001.0101000 value", "DFEDTARU value"],
          "next_check_date": "2026-10-01",
          "conditions": {
            "falsify": [
              {"id": "krw_strong", "kind": "threshold", "category": "macro",
               "subject": "731Y001.0000001", "metric": "value", "op": "<=", "value": 1250.0}
            ],
            "weaken": [
              {"id": "krw_firming", "kind": "threshold", "category": "macro",
               "subject": "731Y001.0000001", "metric": "value", "op": "<=", "value": 1350.0}
            ],
            "strengthen": [
              {"id": "krw_weak", "kind": "threshold", "category": "macro",
               "subject": "731Y001.0000001", "metric": "value", "op": ">=", "value": 1400.0}
            ]
          }
        }
      ]
